{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "miu-controle",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Um único Worker: /api/* cai no Hono, o resto é servido direto dos assets da SPA (apps/web/dist).
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Roda o Worker perto do Neon (São Paulo), não perto do usuário: cada request faz várias queries.
  "placement": { "mode": "smart" },

  "observability": { "enabled": true },

  // Todo dia às 06:00 de Brasília (09:00 UTC): recorrências e lançamentos automáticos.
  "triggers": { "crons": ["0 11 * * *", "0 23 * * *"] },

  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // Neon via Hyperdrive (pool + cache de leitura). Em dev local a conexão vem de
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE no arquivo apps/api/.env
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "ce70e8fb86834ce0b02fc1e34ea27198"
    }
  ],

  // Limite de tentativas nas rotas de login/cadastro/senha (binding grátis): 10 por minuto por IP.
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  "vars": {
    "APP_ENV": "production",
    "APP_URL": "https://miu-controle.miu-api.workers.dev",
    // Web Push: chave PÚBLICA do VAPID (a privada é o secret VAPID_PRIVATE_KEY).
    "VAPID_PUBLIC_KEY": "BA858ahP7biXqcKQc_gBmauO7UCP0QaEpy8Lm6KGXB7x5XlCjs7VHnzVO5QuTT3xTjE0CXpk-n5OZgTtvV9w6oQ"
  }
}

# Copie para apps/api/.env (não vai para o git). O wrangler lê este arquivo em `pnpm dev`.

# Banco em dev. Duas opções:
#  a) offline: rode `pnpm db:local` (Postgres em PGlite na porta 5433) e use a linha abaixo;
#  b) Neon: cole a string do branch "dev" do Neon.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable

# Endereço que você abre no navegador em dev (o Vite faz proxy de /api para o wrangler).
APP_URL=http://localhost:5173
APP_ENV=development

# Qualquer texto aleatório com 32+ caracteres. Em produção: `wrangler secret put BETTER_AUTH_SECRET`.
BETTER_AUTH_SECRET=troque-por-um-segredo-aleatorio-com-32-caracteres

# Opcionais (sem eles: e-mails saem no terminal, sem Turnstile, sem login com Google).
# RESEND_API_KEY=
# EMAIL_FROM=Miu Controle <nao-responda@seudominio.com.br>
# TURNSTILE_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
